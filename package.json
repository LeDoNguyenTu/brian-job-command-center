{
  "name": "brian-job-command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/app-source.test.mjs",
    "test:discovery": "node --experimental-strip-types --test tests/discovery-*.test.ts",
    "test:source-first": "npm run test:discovery && node --test tests/discovery-*.test.mjs tests/settings-function-list.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern dist --ignore-pattern .sites-runtime --ignore-pattern .wrangler"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "mammoth": "1.12.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Brian Job Command Center"
}
